#include <WiFi.h>
#include <WebServer.h>
#include <ArduinoJson.h>
#include <HardwareSerial.h>

// WiFi Configuration - UPDATE THESE!
const char* ssid = "YOUR_SSID";
const char* password = "YOUR_PASSWORD";

// Web Server on port 80
WebServer server(80);

// Serial Communication with Flashforge Printer
HardwareSerial& flashforgeSerial = Serial1;
const unsigned long SERIAL_BAUD = 115200;

// Printer State
struct PrinterState {
  bool isConnected = false;
  bool isPrinting = false;
  float nozzleTemp = 0.0;
  float nozzleTempTarget = 0.0;
  float bedTemp = 0.0;
  float bedTempTarget = 0.0;
  int progress = 0;
  String currentFile = "";
  String status = "Idle";
  unsigned long printTime = 0;
};

PrinterState printerState;
unsigned long lastStatusCheck = 0;
const unsigned long STATUS_CHECK_INTERVAL = 5000;

// Function Prototypes
void initWiFi();
void setupWebServer();
void handleRoot();
void handleStatus();
void handleCommand();
void handlePrintStart();
void handlePrintStop();
void handleTempSet();
void handleFileList();
void updatePrinterStatus();
void sendFlashforgeCommand(String command);
String readFlashforgeResponse();
void parseFlashforgeResponse(String response);
void connectPrinter();

void setup() {
  Serial.begin(115200);
  delay(2000);
  Serial.println("\n\n=== Flashforge OctoPrint Server Starting ===");
  
  flashforgeSerial.begin(SERIAL_BAUD);
  delay(500);
  
  initWiFi();
  setupWebServer();
  server.begin();
  
  Serial.println("HTTP Server started on port 80");
  Serial.println("Access dashboard at: http://<Arduino_IP>");
}

void loop() {
  server.handleClient();
  
  if (millis() - lastStatusCheck >= STATUS_CHECK_INTERVAL) {
    if (printerState.isConnected) {
      updatePrinterStatus();
    }
    lastStatusCheck = millis();
  }
}

void initWiFi() {
  Serial.println("\nConnecting to WiFi: " + String(ssid));
  WiFi.begin(ssid, password);
  
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 20) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\n✓ WiFi connected!");
    Serial.println("IP address: " + WiFi.localIP().toString());
  } else {
    Serial.println("\n✗ Failed to connect to WiFi");
  }
}

void setupWebServer() {
  server.on("/", HTTP_GET, handleRoot);
  server.on("/api/status", HTTP_GET, handleStatus);
  server.on("/api/command", HTTP_POST, handleCommand);
  server.on("/api/print/start", HTTP_POST, handlePrintStart);
  server.on("/api/print/stop", HTTP_POST, handlePrintStop);
  server.on("/api/temp/set", HTTP_POST, handleTempSet);
  server.on("/api/files", HTTP_GET, handleFileList);
  server.on("/api/connect", HTTP_POST, []() {
    connectPrinter();
    server.send(200, "application/json", "{\"status\":\"connecting\"}");
  });
}

