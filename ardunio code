void handleStatus() {
  StaticJsonDocument<256> doc;
  doc["isConnected"] = printerState.isConnected;
  doc["isPrinting"] = printerState.isPrinting;
  doc["nozzleTemp"] = printerState.nozzleTemp;
  doc["nozzleTempTarget"] = printerState.nozzleTempTarget;
  doc["bedTemp"] = printerState.bedTemp;
  doc["bedTempTarget"] = printerState.bedTempTarget;
  doc["progress"] = printerState.progress;
  doc["currentFile"] = printerState.currentFile;
  doc["status"] = printerState.status;
  doc["printTime"] = printerState.printTime;
  
  String response;
  serializeJson(doc, response);
  server.send(200, "application/json", response);
}

void handleCommand() {
  if (server.hasArg("plain")) {
    StaticJsonDocument<256> doc;
    deserializeJson(doc, server.arg("plain"));
    String command = doc["command"];
    
    if (command == "disconnect") {
      printerState.isConnected = false;
      printerState.status = "Disconnected";
    }
  }
  server.send(200, "application/json", "{\"success\":true}");
}

void handlePrintStart() {
  sendFlashforgeCommand("~M6030");
  printerState.isPrinting = true;
  printerState.status = "Printing";
  server.send(200, "application/json", "{\"success\":true}");
}

void handlePrintStop() {
  sendFlashforgeCommand("~M6035");
  printerState.isPrinting = false;
  printerState.status = "Stopped";
  server.send(200, "application/json", "{\"success\":true}");
}

void handleTempSet() {
  if (server.hasArg("plain")) {
    StaticJsonDocument<256> doc;
    deserializeJson(doc, server.arg("plain"));
    String type = doc["type"];
    float temp = doc["temperature"];
    
    String command = "";
    if (type == "nozzle") {
      command = "~M109 S" + String((int)temp);
      printerState.nozzleTempTarget = temp;
    } else if (type == "bed") {
      command = "~M190 S" + String((int)temp);
      printerState.bedTempTarget = temp;
    }
    sendFlashforgeCommand(command);
  }
  server.send(200, "application/json", "{\"success\":true}");
}

void handleFileList() {
  StaticJsonDocument<256> doc;
  JsonArray files = doc.createNestedArray("files");
  files.add("sample_model.gcode");
  files.add("test_print.gcode");
  
  String response;
  serializeJson(doc, response);
  server.send(200, "application/json", response);
}

void connectPrinter() {
  Serial.println("Attempting to connect to Flashforge...");
  sendFlashforgeCommand("~M601 S0");
  delay(1000);
  printerState.isConnected = true;
  printerState.status = "Connected";
  Serial.println("✓ Connection initiated");
}

void updatePrinterStatus() {
  sendFlashforgeCommand("~M105");
  delay(100);
  String response = readFlashforgeResponse();
  parseFlashforgeResponse(response);
  
  sendFlashforgeCommand("~M27");
  delay(100);
  response = readFlashforgeResponse();
}

void sendFlashforgeCommand(String command) {
  flashforgeSerial.print(command);
  flashforgeSerial.print("\r\n");
  Serial.println(">> CMD: " + command);
}

String readFlashforgeResponse() {
  String response = "";
  unsigned long timeout = millis() + 1000;
  
  while (millis() < timeout) {
    if (flashforgeSerial.available()) {
      char c = flashforgeSerial.read();
      response += c;
      if (c == '\n') break;
    }
  }
  
  if (response.length() > 0) {
    Serial.println("<< RESP: " + response);
  }
  return response;
}

void parseFlashforgeResponse(String response) {
  if (response.indexOf("T0:") >= 0) {
    int idx = response.indexOf("T0:");
    printerState.nozzleTemp = response.substring(idx + 3).toFloat();
  }
  if (response.indexOf("B:") >= 0) {
    int idx = response.indexOf("B:");
    printerState.bedTemp = response.substring(idx + 2).toFloat();
  }
}
